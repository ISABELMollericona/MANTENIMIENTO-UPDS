// Estados del equipo (tabla EstadoEquipo, comportamiento por "tipo").
digraph estados_equipo {
  graph [rankdir=TB, bgcolor="white", fontname="Arial", fontsize=12, pad=0.2, nodesep=0.6, ranksep=0.5, labelloc=t,
         label=<<FONT POINT-SIZE="15" COLOR="#064B87"><B>Diagrama de estados · equipo</B></FONT><BR/><FONT POINT-SIZE="9.5" COLOR="#5D6875">Los nombres se editan en Equipos › Estados; el sistema usa el comportamiento (tipo)</FONT>>];
  node  [fontname="Arial", fontsize=10.5, shape=box, style="rounded,filled", color="#064B87", penwidth=1.3, margin="0.18,0.08"];
  edge  [fontname="Arial", fontsize=9, color="#4B6378", fontcolor="#33475B", arrowsize=0.75];

  inicio [label="", shape=circle, style=filled, fillcolor="#064B87", width=0.22, fixedsize=true];
  operativo [label=<<B>Operativo</B><BR/><FONT POINT-SIZE="9">tipo: operativo</FONT>>, fillcolor="#E3F4EA"];
  reparacion [label=<<B>En mantenimiento/reparación</B><BR/><FONT POINT-SIZE="9">tipo: reparacion</FONT>>, fillcolor="#FFF4D1"];
  baja [label=<<B>Obsoleto/Dado de baja</B><BR/><FONT POINT-SIZE="9">tipo: baja</FONT>>, fillcolor="#ECEFF2"];
  fin [label="", shape=doublecircle, style=filled, fillcolor="#064B87", width=0.18, fixedsize=true];

  inicio -> operativo [label=" registro del equipo\n (estado por defecto)"];
  operativo -> reparacion [label=" el reporte pasa a En reparación\n (salida registrada) o edición manual"];
  reparacion -> operativo [label=" devolución Reparado / Parcial\n o reporte cancelado", constraint=false];
  reparacion -> reparacion [label=" devolución No reparable\n (espera la baja)"];
  operativo -> baja [label=" Registrar baja\n (motivo, fecha, Vicerrectoría)"];
  reparacion -> baja [label=" Registrar baja"];
  baja -> fin [label=" la baja oficial la hace\n Vicerrectoría (fuera del sistema)"];

  nota [label="Cada cambio queda en HistorialEquipo\ncon el usuario y la fecha.\nLos equipos no se eliminan.", shape=note, style=filled, fillcolor="#FFF8E1", color="#E0A800", fontsize=9.5];
  { rank=same; inicio; nota; }
}
